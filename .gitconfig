[user]
	name = Stepan Martynovskiy
	email = martin-sv@bk.ru

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
	
[core]
    pager = delta
    excludesfile = /Users/s1kai/.gitignore_global
    
[interactive]
    diffFilter = delta --color-only

[delta]
    # syntax-theme and dark/light come from the include at the bottom,
    # which noctalia regenerates; git reads it last, so it wins.
    side-by-side = true
    navigate = true
    true-color = always
    features = decorations
    line-numbers = true

[merge]
    conflictstyle = zdiff3
    tool = nvimdiff
	
[diff]
    tool = nvimdiff
    submodule = log
[rerere]
	enabled = true
	autoUpdate = true
[fetch]
	writeCommitGraph = true
[maintenance]
	repo = $HOME/aviasales/delta
	repo = $HOME/aviasales/delta-full
	repo = $HOME/aviasales/terraform

# Must stay last: git applies includes where they appear.
[include]
	path = ~/.config/git/noctalia-delta.gitconfig
